{
  "name": "exam-prep-app",
  "private": true,
  "version": "1.0.0",
  "description": "Study app for one Microsoft certification exam: illustrated lessons, practice questions, an exam simulation and flashcards",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "validate": "node scripts/validate-content.ts",
    "check:learn": "node scripts/check-learn.ts && node scripts/model-lifecycle.ts --check",
    "check:links": "node scripts/check-links.ts",
    "audit:diagrams": "node scripts/audit-diagrams.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "icons:pwa": "node scripts/gen-pwa-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run validate",
    "export:lessons": "node scripts/export-lessons.ts",
    "sources:titles": "node scripts/source-titles.ts",
    "models:refresh": "node scripts/model-lifecycle.ts"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.345",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0-alpha-2026-10-30",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
