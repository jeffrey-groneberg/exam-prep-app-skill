{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case study file",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "scenario", "modules"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^case-[a-z0-9-]+$" },
          "title": { "$ref": "#/$defs/l10n" },
          "scenario": { "$ref": "#/$defs/l10n" },
          "modules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "l10n": {
      "type": "object",
      "required": ["en", "de"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 2 },
        "de": { "type": "string", "minLength": 2 }
      }
    }
  }
}
