{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question file",
  "description": "One file per course module. All questions are original and grounded in current learn.microsoft.com documentation.",
  "type": "object",
  "required": ["module", "questions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "module": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "l10n": {
      "type": "object",
      "required": ["en", "de"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 2 },
        "de": { "type": "string", "minLength": 2 }
      }
    },
    "choiceOption": {
      "type": "object",
      "required": ["id", "text", "correct", "why"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "text": { "$ref": "#/$defs/l10n" },
        "correct": { "type": "boolean" },
        "why": { "$ref": "#/$defs/l10n" }
      }
    },
    "base": {
      "type": "object",
      "required": ["id", "type", "domain", "skill", "module", "difficulty", "stem", "explanation", "sources", "lastVerified"],
      "properties": {
        "id": { "type": "string", "pattern": "^q-[a-z0-9-]+$" },
        "type": { "enum": ["single", "multi", "order", "match", "code"] },
        "domain": { "type": "string", "pattern": "^D[1-9][0-9]*$" },
        "skill": { "type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$" },
        "skills": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$" } },
        "module": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "difficulty": { "enum": [1, 2, 3] },
        "caseId": { "type": "string", "pattern": "^case-[a-z0-9-]+$" },
        "stem": { "$ref": "#/$defs/l10n" },
        "code": { "type": "string" },
        "explanation": { "$ref": "#/$defs/l10n" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^https://learn\\.microsoft\\.com/" }
        },
        "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "question": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "oneOf": [
        {
          "properties": {
            "type": { "enum": ["single", "multi"] },
            "options": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "$ref": "#/$defs/choiceOption" } }
          },
          "required": ["options"]
        },
        {
          "properties": {
            "type": { "const": "order" },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 7,
              "items": {
                "type": "object",
                "required": ["id", "text", "why"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
                  "text": { "$ref": "#/$defs/l10n" },
                  "why": { "$ref": "#/$defs/l10n" }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "match" },
            "prompts": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": ["id", "prompt", "answer", "why"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
                  "prompt": { "$ref": "#/$defs/l10n" },
                  "answer": { "type": "string" },
                  "why": { "$ref": "#/$defs/l10n" }
                }
              }
            },
            "targets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["id", "text"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
                  "text": { "$ref": "#/$defs/l10n" }
                }
              }
            }
          },
          "required": ["prompts", "targets"]
        },
        {
          "properties": {
            "type": { "const": "code" },
            "template": { "type": "string", "minLength": 10 },
            "blanks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["id", "options"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
                  "options": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "required": ["id", "code", "correct", "why"],
                      "additionalProperties": false,
                      "properties": {
                        "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
                        "code": { "type": "string", "minLength": 1 },
                        "correct": { "type": "boolean" },
                        "why": { "$ref": "#/$defs/l10n" }
                      }
                    }
                  }
                }
              }
            }
          },
          "required": ["template", "blanks"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
